<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.vyhyb.BMeasureLog</id>
  <name>BMeasureLog</name>
  <summary>Log readings from Bluetooth laser distance meters</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <url type="homepage">https://github.com/vyhyb/bmeasurelog</url>
